{
  "name": "madventures-site",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "MAD Ventures software-company website",
  "scripts": {
    "dev": "next dev -p 4193",
    "build": "next build",
